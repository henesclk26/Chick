#FullScreenBlackOverlay {
    position: absolute; left: 0; top: 0; right: 0; bottom: 0;
    background-color: rgb(0,0,0); opacity: 1; display: none;
    align-items: center; justify-content: center;
}
#DayLabel { font-size: 52px; letter-spacing: 6px; color: rgb(255,242,214); -unity-font-style: bold; opacity: 0; }
#SavingLabel { position: absolute; bottom: 70px; left: 40px; right: 40px; font-size: 23px; color: rgb(234,225,208); display: none; white-space: normal; -unity-text-align: middle-center; }

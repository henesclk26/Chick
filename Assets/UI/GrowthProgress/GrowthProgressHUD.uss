#GrowthProgressHUD {
    position: absolute;
    top: 30px;
    left: 0;
    right: 0;
    align-items: center;
    display: none;
}
#GrowthBarRoot {
    width: 60%;
    max-width: 740px;
    min-width: 240px;
    height: 70px;
    justify-content: center;
}
#GrowthBarContainer {
    width: 100%;
    height: 70px;
    flex-shrink: 0;
}
#GrowthGlow {
    display: none;
    position: absolute;
    left: 0;
    right: 0;
    top: 20px;
    height: 32px;
    opacity: 0;
}
#GrowthGlowOuter {
    position: absolute;
    left: -7px;
    right: -7px;
    top: -7px;
    bottom: -7px;
    border-width: 4px;
    border-radius: 7px;
    border-color: rgba(104, 231, 96, .18);
}
#GrowthGlowInner {
    position: absolute;
    left: -3px;
    right: -3px;
    top: -3px;
    bottom: -3px;
    border-width: 3px;
    border-radius: 3px;
    border-color: rgba(120, 245, 104, .85);
}
#LeftIcon, #RightIcon {
    display: none;
    position: absolute;
    top: 2px;
    height: 50px;
    -unity-background-scale-mode: scale-to-fit;
}
#LeftIconGlow, #RightIconGlow { display: none; }
#LeftIcon { width: 38px; left: -38px; }
#RightIcon {
    display: flex;
    width: 48px;
    height: 50px;
    top: 2px;
    right: -48px;
}
#GrowthProgressHUD.egg-laying #RightIcon {
    display: flex;
    width: 44px;
    height: 54px;
    top: -1px;
    right: -15px;
    rotate: 10deg;
}
#EggPickupRoot, #StationPromptRoot {
    position: absolute;
    bottom: 14%;
    left: 0;
    right: 0;
    align-items: center;
    display: none;
}
#UpgradeNotificationRoot {
    display: none;
    margin-top: 4px;
    height: 50px;
    align-items: center;
    justify-content: center;
}
#GrowthReadyLabel, #UpgradePrompt, .interaction-prompt {
    background-color: rgba(255, 245, 211, .94);
    border-color: rgb(39, 43, 30);
    border-width: 2px;
    border-radius: 12px;
    padding-left: 14px;
    padding-right: 14px;
    height: 50px;
}
#GrowthReadyLabel {
    color: rgb(38, 74, 30);
    font-size: 21px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}
#UpgradePrompt {
    display: none;
}
#UpgradePrompt, .interaction-prompt {
    flex-direction: row;
    align-items: center;
}
#UpgradeHoldIndicator, .interaction-key-slot {
    width: 40px;
    height: 40px;
    margin-right: 9px;
    flex-shrink: 0;
}
.interaction-key-slot {
    align-items: center;
    justify-content: center;
}
.interaction-key-circle {
    width: 38px;
    height: 38px;
    border-radius: 19px;
    border-width: 4px;
    border-color: rgb(59, 66, 51);
}
/* Word keys such as TAB get a rounded key cap instead of the circle. */
.interaction-key-slot.wide-key {
    width: 58px;
}
.wide-key .interaction-key-circle {
    width: 56px;
    border-radius: 10px;
}
.wide-key .interaction-key {
    font-size: 17px;
}
/* Station prompt: the TAB key cap sticks out of the box's left edge; the label stays inside. */
.keycap-out {
    margin-left: 32px;
    padding-left: 40px;
}
.keycap-out .interaction-key-slot {
    position: absolute;
    left: -32px;
    top: -6px;
    width: 64px;
    height: 58px;
    margin-right: 0;
}
.keycap-out .interaction-key-circle {
    width: 64px;
    height: 58px;
    border-radius: 12px;
    border-width: 3px;
    border-bottom-width: 7px;
    border-color: rgb(39, 43, 30);
    background-color: rgb(255, 250, 230);
}
.keycap-out .interaction-key {
    bottom: 4px;
    font-size: 18px;
}
#UpgradeKey, .interaction-key {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    margin: 0;
    padding: 0;
    color: rgb(18, 19, 21);
    font-size: 20px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}
#UpgradeText, .interaction-text {
    margin: 0;
    padding: 0;
    color: rgb(18, 19, 21);
    font-size: 19px;
    -unity-font-style: bold;
    -unity-text-outline-color: rgb(18, 19, 21);
    -unity-text-outline-width: .25px;
}

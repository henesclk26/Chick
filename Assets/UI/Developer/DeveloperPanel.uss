.developer-overlay {
    position: absolute;
    left: 0; right: 0; top: 0; bottom: 0;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    padding-left: 20px; padding-right: 20px;
    background-color: rgba(6, 17, 15, 0.64);
}
.developer-panel {
    width: 840px;
    max-width: 96%;
    height: 740px;
    max-height: 92%;
    flex-direction: column;
    overflow: hidden;
    background-color: rgb(25, 38, 33);
    border-left-width: 2px; border-right-width: 2px;
    border-top-width: 2px; border-bottom-width: 2px;
    border-left-color: rgb(112, 137, 110); border-right-color: rgb(112, 137, 110);
    border-top-color: rgb(112, 137, 110); border-bottom-color: rgb(112, 137, 110);
    border-top-left-radius: 12px; border-top-right-radius: 12px;
    border-bottom-left-radius: 12px; border-bottom-right-radius: 12px;
}
.panel-header {
    height: 88px;
    flex-shrink: 0;
    padding-left: 22px; padding-right: 20px;
    flex-direction: row;
    align-items: center;
    background-color: rgb(34, 53, 43);
    border-bottom-width: 2px;
    border-bottom-color: rgb(115, 145, 104);
}
.brand-mark {
    width: 43px; height: 43px;
    margin-right: 15px;
    align-items: center;
    justify-content: center;
    background-color: rgb(211, 168, 87);
    border-top-left-radius: 8px; border-top-right-radius: 8px;
    border-bottom-left-radius: 8px; border-bottom-right-radius: 8px;
}
.brand-letter {
    color: rgb(39, 47, 32);
    font-size: 22px;
    -unity-font-style: bold;
}
.title-block { flex-grow: 1; justify-content: center; }
.eyebrow {
    color: rgb(204, 184, 129);
    font-size: 11px;
    letter-spacing: 1.5px;
    -unity-font-style: bold;
}
.panel-title {
    margin-top: 4px;
    color: rgb(249, 245, 226);
    font-size: 25px;
    -unity-font-style: bold;
}
.header-badge {
    margin-right: 16px;
    padding-left: 10px; padding-right: 10px;
    padding-top: 5px; padding-bottom: 5px;
    color: rgb(172, 197, 162);
    background-color: rgb(46, 70, 52);
    border-top-left-radius: 4px; border-top-right-radius: 4px;
    border-bottom-left-radius: 4px; border-bottom-right-radius: 4px;
    font-size: 10px;
    letter-spacing: 1px;
    -unity-font-style: bold;
}
.close-button {
    width: 36px; height: 36px;
    padding-left: 0; padding-right: 0; padding-top: 0; padding-bottom: 2px;
    background-color: rgb(64, 82, 69);
    color: rgb(239, 237, 220);
    border-left-width: 0; border-right-width: 0;
    border-top-width: 0; border-bottom-width: 0;
    border-top-left-radius: 6px; border-top-right-radius: 6px;
    border-bottom-left-radius: 6px; border-bottom-right-radius: 6px;
    font-size: 23px;
    -unity-text-align: middle-center;
}
.close-button:hover { background-color: rgb(112, 85, 69); }
.panel-content {
    flex-grow: 1;
    min-height: 0;
    flex-direction: row;
    padding-left: 18px; padding-right: 18px;
    padding-top: 16px; padding-bottom: 16px;
}
.card {
    background-color: rgb(37, 53, 45);
    border-left-width: 1px; border-right-width: 1px;
    border-top-width: 1px; border-bottom-width: 1px;
    border-left-color: rgb(84, 108, 86); border-right-color: rgb(84, 108, 86);
    border-top-color: rgb(84, 108, 86); border-bottom-color: rgb(84, 108, 86);
    border-top-left-radius: 8px; border-top-right-radius: 8px;
    border-bottom-left-radius: 8px; border-bottom-right-radius: 8px;
}
.time-card {
    width: 345px;
    flex-shrink: 0;
    margin-right: 14px;
    padding-left: 18px; padding-right: 18px;
    padding-top: 18px; padding-bottom: 14px;
}
.card-heading { flex-shrink: 0; }
.section-heading {
    color: rgb(240, 228, 182);
    font-size: 14px;
    letter-spacing: 1px;
    -unity-font-style: bold;
}
.section-help {
    margin-top: 5px;
    color: rgb(177, 194, 176);
    font-size: 12px;
}
.clock-face {
    height: 130px;
    margin-top: 15px;
    align-items: center;
    justify-content: center;
    background-color: rgb(19, 33, 29);
    border-left-width: 1px; border-right-width: 1px;
    border-top-width: 1px; border-bottom-width: 1px;
    border-left-color: rgb(75, 98, 78); border-right-color: rgb(75, 98, 78);
    border-top-color: rgb(75, 98, 78); border-bottom-color: rgb(75, 98, 78);
    border-top-left-radius: 7px; border-top-right-radius: 7px;
    border-bottom-left-radius: 7px; border-bottom-right-radius: 7px;
}
.clock-caption {
    color: rgb(143, 174, 139);
    font-size: 11px;
    letter-spacing: 1.6px;
    -unity-font-style: bold;
}
.time-value {
    margin-top: 1px;
    color: rgb(249, 225, 159);
    font-size: 43px;
    -unity-font-style: bold;
}
.clock-hint {
    color: rgb(157, 174, 156);
    font-size: 11px;
}
.hour-step-row {
    height: 42px;
    margin-top: 11px;
    flex-direction: row;
}
.step-button {
    flex-grow: 1;
    margin-right: 6px;
    padding-left: 0; padding-right: 0;
    background-color: rgb(82, 113, 81);
    color: rgb(251, 245, 224);
    border-left-width: 0; border-right-width: 0;
    border-top-width: 0; border-bottom-width: 0;
    border-top-left-radius: 5px; border-top-right-radius: 5px;
    border-bottom-left-radius: 5px; border-bottom-right-radius: 5px;
    font-size: 13px;
    -unity-font-style: bold;
}
.step-button:hover { background-color: rgb(107, 142, 96); }
.mini-heading {
    margin-top: 13px;
    color: rgb(178, 196, 171);
    font-size: 10px;
    letter-spacing: 1px;
    -unity-font-style: bold;
}
.preset-row {
    height: 36px;
    margin-top: 7px;
    flex-direction: row;
}
.preset-button {
    flex-grow: 1;
    margin-right: 5px;
    padding-left: 2px; padding-right: 2px;
    background-color: rgb(54, 71, 59);
    color: rgb(232, 231, 210);
    border-left-width: 1px; border-right-width: 1px;
    border-top-width: 1px; border-bottom-width: 1px;
    border-left-color: rgb(93, 116, 92); border-right-color: rgb(93, 116, 92);
    border-top-color: rgb(93, 116, 92); border-bottom-color: rgb(93, 116, 92);
    border-top-left-radius: 5px; border-top-right-radius: 5px;
    border-bottom-left-radius: 5px; border-bottom-right-radius: 5px;
    font-size: 11px;
}
.preset-button:hover { background-color: rgb(83, 108, 78); }
.right-column { flex-grow: 1; min-width: 0; flex-direction: column; }
.form-card {
    height: 144px;
    flex-shrink: 0;
    padding-left: 17px; padding-right: 17px;
    padding-top: 16px; padding-bottom: 14px;
}
.form-row {
    height: 43px;
    flex-direction: row;
    margin-top: 12px;
}
.choice-button {
    flex-grow: 1;
    margin-right: 7px;
    background-color: rgb(54, 72, 59);
    color: rgb(241, 239, 219);
    border-left-width: 1px; border-right-width: 1px;
    border-top-width: 1px; border-bottom-width: 1px;
    border-left-color: rgb(101, 123, 97); border-right-color: rgb(101, 123, 97);
    border-top-color: rgb(101, 123, 97); border-bottom-color: rgb(101, 123, 97);
    border-top-left-radius: 5px; border-top-right-radius: 5px;
    border-bottom-left-radius: 5px; border-bottom-right-radius: 5px;
    font-size: 15px;
}
.choice-button:hover { background-color: rgb(81, 106, 78); }
.choice-button.selected {
    background-color: rgb(164, 193, 126);
    color: rgb(28, 47, 28);
    -unity-font-style: bold;
}
.destination-card {
    flex-grow: 1;
    min-height: 0;
    margin-top: 13px;
    padding-left: 17px; padding-right: 17px;
    padding-top: 16px; padding-bottom: 12px;
}
.destination-button {
    /* Four destinations share the card's fixed height. */
    height: 28px;
    margin-top: 4px;
    padding-left: 8px; padding-right: 10px;
    flex-direction: row;
    align-items: center;
    background-color: rgb(52, 71, 58);
    border-left-width: 1px; border-right-width: 1px;
    border-top-width: 1px; border-bottom-width: 1px;
    border-left-color: rgb(91, 118, 89); border-right-color: rgb(91, 118, 89);
    border-top-color: rgb(91, 118, 89); border-bottom-color: rgb(91, 118, 89);
    border-top-left-radius: 5px; border-top-right-radius: 5px;
    border-bottom-left-radius: 5px; border-bottom-right-radius: 5px;
}
.destination-button:hover { background-color: rgb(77, 105, 75); }
.destination-number {
    width: 32px;
    color: rgb(226, 188, 112);
    font-size: 12px;
    -unity-font-style: bold;
}
.destination-name {
    flex-grow: 1;
    color: rgb(245, 242, 226);
    font-size: 14px;
    -unity-font-style: bold;
}
.destination-arrow {
    color: rgb(213, 228, 191);
    font-size: 20px;
}
.panel-footer {
    height: 44px;
    flex-shrink: 0;
    padding-left: 22px; padding-right: 22px;
    flex-direction: row;
    align-items: center;
    background-color: rgb(29, 44, 36);
    border-top-width: 1px;
    border-top-color: rgb(90, 112, 87);
}
.status-dot {
    width: 7px; height: 7px;
    margin-right: 9px;
    background-color: rgb(168, 201, 128);
    border-top-left-radius: 4px; border-top-right-radius: 4px;
    border-bottom-left-radius: 4px; border-bottom-right-radius: 4px;
}
.status-label {
    flex-grow: 1;
    color: rgb(207, 219, 194);
    font-size: 12px;
}
.keycap {
    margin-right: 8px;
    padding-left: 7px; padding-right: 7px;
    padding-top: 3px; padding-bottom: 3px;
    color: rgb(242, 232, 197);
    background-color: rgb(67, 88, 68);
    border-top-left-radius: 4px; border-top-right-radius: 4px;
    border-bottom-left-radius: 4px; border-bottom-right-radius: 4px;
    font-size: 11px;
    -unity-font-style: bold;
}
.footer-shortcut {
    color: rgb(174, 194, 167);
    font-size: 11px;
    letter-spacing: 1px;
    -unity-font-style: bold;
}
/* Keep every control reachable in smaller game viewports. */
.panel-scroll { flex-grow: 1; min-height: 0; }
.panel-content { flex-grow: 0; flex-shrink: 0; height: 406px; }
.movement-card {
    flex-shrink: 0;
    margin-left: 18px; margin-right: 18px; margin-bottom: 16px;
    padding-left: 16px; padding-right: 16px; padding-top: 13px; padding-bottom: 14px;
}
.movement-toggle-row { flex-direction: row; flex-wrap: wrap; margin-top: 10px; }
.movement-toggle {
    flex-grow: 1; flex-basis: 210px; min-width: 190px; min-height: 96px;
    margin-left: 0; margin-right: 6px; margin-top: 4px; margin-bottom: 0;
    padding-left: 12px; padding-right: 10px; padding-top: 9px; padding-bottom: 9px;
    align-items: flex-start;
    background-color: rgb(48, 66, 54);
    border-left-width: 1px; border-right-width: 1px; border-top-width: 1px; border-bottom-width: 1px;
    border-left-color: rgb(91, 118, 89); border-right-color: rgb(91, 118, 89);
    border-top-color: rgb(91, 118, 89); border-bottom-color: rgb(91, 118, 89);
    border-top-left-radius: 6px; border-top-right-radius: 6px;
    border-bottom-left-radius: 6px; border-bottom-right-radius: 6px;
}
.movement-toggle:hover { background-color: rgb(67, 90, 66); }
.movement-toggle:focus {
    border-left-color: rgb(238, 204, 127); border-right-color: rgb(238, 204, 127);
    border-top-color: rgb(238, 204, 127); border-bottom-color: rgb(238, 204, 127);
}
.toggle-title { color: rgb(242, 236, 209); font-size: 14px; -unity-font-style: bold; }
.toggle-help { color: rgb(181, 198, 174); font-size: 11px; margin-top: 3px; white-space: normal; }
.toggle-state {
    margin-top: 8px; padding-left: 7px; padding-right: 7px; padding-top: 2px; padding-bottom: 2px;
    background-color: rgb(30, 45, 36); color: rgb(186, 201, 178);
    font-size: 10px; -unity-font-style: bold;
    border-top-left-radius: 4px; border-top-right-radius: 4px;
    border-bottom-left-radius: 4px; border-bottom-right-radius: 4px;
}
.movement-toggle.selected { background-color: rgb(83, 111, 68); }
.movement-toggle.selected .toggle-state { background-color: rgb(195, 218, 148); color: rgb(27, 44, 27); }

.egg-card {
    flex-direction: row; align-items: center; flex-shrink: 0;
    margin-left: 18px; margin-right: 18px; margin-bottom: 16px;
    padding-left: 16px; padding-right: 16px; padding-top: 13px; padding-bottom: 13px;
}
.egg-info { flex-grow: 1; min-width: 0; }
.egg-info .section-help { white-space: normal; }
.egg-balance-label { color: rgb(249, 225, 159); font-size: 13px; margin-top: 8px; }
.egg-grant-button { flex-grow: 0; flex-shrink: 0; width: 155px; height: 44px; margin-left: 14px; }
.egg-grant-button:disabled { background-color: rgb(45, 58, 49); color: rgb(125, 143, 124); opacity: 0.65; }

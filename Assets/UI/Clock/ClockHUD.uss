/* The time of day, with no panel behind it, in one of two looks (ClockHUDController):
   - lettered: soft black Fredoka (rounded, OFL; Assets/UI/Fonts), a thin cream rim and a soft glow;
   - segments: a bold black seven-segment readout, drawn by ClockHUDController as pointed segments with small gaps at
     the joints and a faint cream rim, so it reads over the trees too. Digit 30 x 52 px. */
#ClockHUD {
    position: absolute; right: 30px; top: 22px; height: 54px;
    flex-direction: row; align-items: center; display: none;
}
#ClockText {
    -unity-font-definition: url("../Fonts/Fredoka-SemiBold.ttf");
    font-size: 44px; letter-spacing: 1px; color: rgb(33, 28, 22);
    -unity-text-outline-width: 1px; -unity-text-outline-color: rgba(255, 249, 232, 0.55);
    text-shadow: 0px 1px 4px rgba(255, 249, 232, 0.6);
    margin: 0; padding: 0;
}
#ClockSegments { flex-direction: row; align-items: center; display: none; }
#ClockHUD.segments #ClockText { display: none; }
#ClockHUD.segments #ClockSegments { display: flex; }

.digit { width: 30px; height: 52px; margin-left: 4px; margin-right: 4px; }
#ClockColon { width: 10px; height: 52px; justify-content: center; align-items: center; margin-left: 1px; margin-right: 1px; }
.dot {
    width: 7px; height: 7px; margin-top: 5px; margin-bottom: 5px; border-radius: 2px;
    background-color: rgb(24, 22, 20); border-width: 1px; border-color: rgba(255, 250, 238, 0.45);
}

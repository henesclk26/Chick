<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <Style src="ClockHUD.uss" />
    <!-- The gameplay corners, no panels behind them: where on the farm the bird is (top left, FarmLocationHUD) and
         the time of day (top right, ClockHUDController). Both show and hide together with the clock. -->
    <ui:VisualElement name="LocationHUD" picking-mode="Ignore">
        <ui:VisualElement name="LocationPin" picking-mode="Ignore" />
        <ui:VisualElement name="LocationNames" picking-mode="Ignore" />
    </ui:VisualElement>
    <ui:VisualElement name="ClockHUD" picking-mode="Ignore">
        <ui:Label name="ClockText" text="07:00" picking-mode="Ignore" />
    </ui:VisualElement>
</ui:UXML>

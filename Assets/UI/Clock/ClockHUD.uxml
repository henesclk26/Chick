<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <Style src="ClockHUD.uss" />
    <!-- The gameplay corners, no panels behind them: where on the farm the bird is (top left, FarmLocationHUD) and
         the time of day (top right, ClockHUDController) and the quests under it (QuestHUD). All show and hide
         together with the clock. -->
    <ui:VisualElement name="LocationHUD" picking-mode="Ignore">
        <ui:VisualElement name="LocationPin" picking-mode="Ignore" />
        <ui:VisualElement name="LocationNames" picking-mode="Ignore" />
    </ui:VisualElement>
    <ui:VisualElement name="ClockHUD" picking-mode="Ignore">
        <ui:Label name="ClockText" text="07:00" picking-mode="Ignore" />
    </ui:VisualElement>
    <!-- Under the clock: the quests (QuestHUD) and, under them, the egg the chicken carries (CarriedEggHUD). -->
    <ui:VisualElement name="SideStack" picking-mode="Ignore">
        <ui:VisualElement name="QuestHUD" picking-mode="Ignore">
            <ui:Label name="QuestHeader" text="GÖREVLER" picking-mode="Ignore" />
            <ui:VisualElement name="QuestList" picking-mode="Ignore" />
        </ui:VisualElement>
        <ui:VisualElement name="CarryHUD" class="off" picking-mode="Ignore">
            <ui:VisualElement name="CarrySlots" picking-mode="Ignore" />
            <ui:Label name="CarryCount" text="1/1" picking-mode="Ignore" />
        </ui:VisualElement>
    </ui:VisualElement>
    <!-- Under the growth bar, for a moment: a region just opened (QuestHUD, FarmRegions). -->
    <ui:VisualElement name="RegionUnlockRow" picking-mode="Ignore">
        <ui:VisualElement name="RegionUnlock" class="off" picking-mode="Ignore">
            <ui:Label name="RegionUnlockHeader" text="YENİ BÖLGE AÇILDI" picking-mode="Ignore" />
            <ui:Label name="RegionUnlockName" text="Ahır" picking-mode="Ignore" />
            <ui:Label name="RegionUnlockHint" text="" picking-mode="Ignore" />
        </ui:VisualElement>
    </ui:VisualElement>
    <!-- Under the growth bar, for a moment: "inventory full" (CarriedEggHUD.ShowFull). -->
    <ui:VisualElement name="CarryFullRow" picking-mode="Ignore">
        <ui:Label name="CarryFull" class="off" text="Envanter dolu! Daha fazla yumurta taşıyamazsın." picking-mode="Ignore" />
    </ui:VisualElement>
</ui:UXML>

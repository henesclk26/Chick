:root { color: rgb(62, 67, 40); font-size: 18px; -unity-font-style: normal; }
#menu-shell { flex-grow: 1; opacity: 0; transition-property: opacity; transition-duration: 0.18s; }
#menu-shell.visible { opacity: 1; }
#menu-backdrop { position: absolute; left: 0; right: 0; top: 0; bottom: 0; background-color: rgb(105, 128, 113); background-image: url("project://database/Assets/UI/Menu/MainMenuCover.png"); -unity-background-scale-mode: scale-and-crop; }
#home { flex-grow: 1; padding-left: 7%; padding-top: 7%; }
#menu-card { width: 580px; padding: 30px 34px 24px; background-color: rgba(0, 0, 0, 0); border-width: 0; border-color: rgba(0, 0, 0, 0); box-shadow: 0 0 0 rgba(0, 0, 0, 0); }
#brand { width: 520px; }
.eyebrow { font-size: 12px; letter-spacing: 2px; color: rgb(255, 222, 119); -unity-font-style: bold; margin-bottom: 10px; -unity-text-outline-width: 1px; -unity-text-outline-color: rgba(22, 40, 27, 0.84); text-shadow: 0px 2px 5px rgba(15, 27, 20, 0.72); }
#game-title { font-size: 82px; -unity-font-style: bold; color: rgb(255, 249, 224); margin-left: -5px; margin-top: -8px; margin-bottom: -5px; -unity-text-outline-width: 2px; -unity-text-outline-color: rgba(22, 40, 27, 0.82); text-shadow: 0px 4px 0px rgba(12, 25, 18, 0.54); }
.tagline { font-size: 19px; color: rgb(255, 249, 224); margin-top: 6px; -unity-text-outline-width: 1px; -unity-text-outline-color: rgba(22, 40, 27, 0.82); text-shadow: 0px 2px 5px rgba(15, 27, 20, 0.72); }
#navigation { width: 300px; margin-top: 25px; }
Button { height: 50px; margin: 4px 0; padding: 8px 20px; border-radius: 11px; border-width: 1px 1px 4px 1px; border-color: rgb(224, 183, 74); background-color: rgb(37, 71, 47); color: rgb(255, 247, 211); -unity-font-style: bold; font-size: 17px; -unity-text-outline-width: 1px; -unity-text-outline-color: rgba(18, 36, 24, 0.58); box-shadow: 0px 4px 0px rgba(16, 28, 19, 0.38); transition-property: background-color, translate, border-bottom-width; transition-duration: 0.10s; }
Button:hover { background-color: rgb(54, 94, 59); translate: 3px 0; }
Button:active { translate: 0px 2px; border-bottom-width: 1px; }
Button:focus { border-left-color: rgb(255, 232, 145); border-right-color: rgb(255, 232, 145); border-top-color: rgb(255, 232, 145); }
Button:disabled { opacity: 0.48; background-color: rgba(30, 49, 36, 0.74); color: rgba(255, 247, 211, 0.58); translate: 0 0; }
Button.primary { background-color: rgb(247, 191, 56); border-color: rgb(177, 121, 27); color: rgb(56, 49, 24); -unity-text-outline-width: 0; box-shadow: 0px 4px 0px rgba(91, 61, 17, 0.38); }
Button.primary:hover { background-color: rgb(255, 210, 88); }
.menu-button { height: 50px; -unity-text-align: middle-left; padding-left: 24px; letter-spacing: 1px; }
Button.quiet { background-color: rgb(35, 66, 44); }
#save-status { font-size: 13px; color: rgb(255, 241, 194); white-space: normal; margin-top: 15px; -unity-text-outline-width: 1px; -unity-text-outline-color: rgba(22, 40, 27, 0.76); text-shadow: 0px 2px 5px rgba(15, 27, 20, 0.72); }
#world-caption { position: absolute; right: 7%; bottom: 9%; font-size: 12px; letter-spacing: 2px; color: rgb(255, 225, 124); -unity-font-style: bold; -unity-text-outline-width: 1px; -unity-text-outline-color: rgba(22, 40, 27, 0.76); text-shadow: 0px 2px 5px rgba(18, 30, 22, 0.55); }
#footer { position: absolute; left: 7%; bottom: 22px; color: rgb(255, 235, 168); font-size: 10px; letter-spacing: 2px; -unity-text-outline-width: 1px; -unity-text-outline-color: rgba(22, 40, 27, 0.76); text-shadow: 0px 2px 5px rgba(18, 30, 22, 0.55); }
.hidden { display: none; }
#settings-page { flex-grow: 1; align-items: center; justify-content: center; background-color: rgba(235, 234, 210, 0.6); }
.settings-card { width: 650px; max-height: 94%; padding: 22px 34px; border-radius: 25px; background-color: rgb(255, 249, 231); border-width: 1px 1px 5px 1px; border-color: rgb(221, 211, 177); }
#settings-page.in-game-settings { background-color: rgba(14, 27, 20, 0.74); }
#settings-page.in-game-settings .settings-card { background-color: rgba(255, 249, 231, 0.98); border-color: rgba(255, 213, 106, 0.78); box-shadow: 0px 18px 30px rgba(8, 18, 12, 0.42); }
.page-title { font-size: 36px; -unity-font-style: bold; margin-bottom: 10px; }
#settings-scroll { flex-shrink: 1; }
.section-title { font-size: 12px; letter-spacing: 2px; -unity-font-style: bold; color: rgb(126, 141, 76); margin-top: 15px; margin-bottom: 9px; }
.setting-row { flex-direction: row; align-items: center; min-height: 35px; }
Slider { flex-grow: 1; margin-right: 15px; }
.unity-base-field { min-height: 32px; margin-top: 3px; margin-bottom: 3px; }
.unity-base-field__label { min-width: 205px; color: rgb(80, 85, 56); font-size: 15px; }
.value { width: 58px; font-size: 13px; -unity-text-align: middle-right; color: rgb(112, 119, 76); }
.setting-row .unity-base-slider__tracker { background-color: rgb(221, 221, 184); height: 5px; border-radius: 4px; }
.setting-row .unity-base-slider__dragger { background-color: rgb(215, 161, 54); border-color: rgb(255, 242, 200); border-width: 2px; border-radius: 20px; width: 17px; height: 17px; margin-top: -6px; }
#settings-scroll .unity-scroller--vertical { width: 9px; margin-left: 8px; }
#settings-scroll .unity-scroller__low-button, #settings-scroll .unity-scroller__high-button { display: none; }
#settings-scroll .unity-scroller--vertical .unity-base-slider__dragger { background-color: rgb(186, 191, 141); border-radius: 8px; border-width: 0; }
.unity-popup-field__input { background-color: rgb(239, 236, 208); border-radius: 6px; border-color: rgb(206, 209, 164); }
.hint { font-size: 11px; color: rgb(134, 133, 99); margin-top: 12px; white-space: normal; }
.actions { flex-direction: row; justify-content: flex-end; margin-top: 17px; }
.actions Button { min-width: 128px; margin-left: 12px; }
.modal { position: absolute; left: 0; right: 0; top: 0; bottom: 0; align-items: center; justify-content: center; background-color: rgba(45, 54, 33, 0.62); }
.dialog { width: 520px; padding: 32px; border-radius: 24px; background-color: rgb(255, 249, 230); border-width: 1px 1px 5px 1px; border-color: rgb(219, 204, 160); }
.dialog-title { font-size: 29px; -unity-font-style: bold; margin-bottom: 13px; }
.dialog-message { font-size: 17px; white-space: normal; color: rgb(114, 112, 80); }
.loading-label { color: rgb(255, 243, 206); font-size: 23px; -unity-font-style: bold; }
.pause-overlay { position: absolute; left: 0; right: 0; top: 0; bottom: 0; align-items: center; justify-content: center; background-color: rgba(14, 27, 20, 0.70); }
.pause-card { width: 430px; padding: 30px 34px 28px; border-radius: 22px; background-color: rgba(28, 55, 37, 0.96); border-width: 1px 1px 5px 1px; border-color: rgba(255, 213, 106, 0.78); box-shadow: 0px 18px 30px rgba(8, 18, 12, 0.42); }
.pause-kicker { font-size: 11px; letter-spacing: 2px; color: rgb(255, 222, 119); -unity-font-style: bold; -unity-text-outline-width: 1px; -unity-text-outline-color: rgba(18, 36, 24, 0.58); }
.pause-title { margin-top: 8px; font-size: 32px; color: rgb(255, 249, 224); -unity-font-style: bold; -unity-text-outline-width: 1px; -unity-text-outline-color: rgba(18, 36, 24, 0.58); }
.pause-copy { margin-top: 8px; font-size: 15px; color: rgba(255, 249, 224, 0.84); }
.pause-divider { height: 1px; margin-top: 20px; margin-bottom: 15px; background-color: rgba(255, 222, 119, 0.30); }
.pause-card Button { width: 100%; margin: 5px 0; }
.pause-card Button.pause-exit { background-color: rgba(104, 61, 44, 0.94); border-color: rgba(255, 204, 102, 0.72); }
.pause-card Button.pause-exit:hover { background-color: rgba(132, 75, 51, 0.96); }
.pause-status { min-height: 18px; margin-top: 8px; font-size: 12px; color: rgb(255, 222, 119); -unity-text-align: middle-center; white-space: normal; }
.pause-hint { margin-top: 14px; font-size: 11px; color: rgba(255, 241, 194, 0.74); -unity-text-align: middle-center; }

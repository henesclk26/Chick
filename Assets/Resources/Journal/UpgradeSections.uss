/* Shared geometry for all three pages; original parchment / worn frame remain intact. */
.reference-skin.section-journal .journal-main { left: 267px; right: 30px; }
.reference-skin.section-journal .journal-content { top: 108px; bottom: 47px; }
.reference-skin .upgrade-section-tabs { flex-direction: row; height: 54px; flex-shrink: 0; margin-bottom: 18px; }
.reference-skin .upgrade-section-tab {
    flex-grow: 1; flex-basis: 0; min-width: 0; height: 54px; margin: 0 3px 0 0;
    background-color: transparent; border-width: 1px; border-color: rgb(145,130,91);
    border-radius: 3px; padding: 0; align-items: center; justify-content: center;
    color: rgb(28,29,19); font-size: 23px; -unity-font-definition: url("ReferenceBold.ttf");
}
.reference-skin .upgrade-section-tab > Label { margin: 0; padding: 0; color: rgb(28,29,19); }
.reference-skin .upgrade-section-tab .section-olive-art { display: none; }
.reference-skin .upgrade-section-tab.section-active { border-bottom-width: 6px; border-bottom-color: rgb(234,187,43); }
.reference-skin .upgrade-section-tab.section-active .section-olive-art { display: flex; }
.reference-skin .upgrade-section-tab.section-active > Label { color: rgb(255,244,213); }
.reference-skin .upgrade-section-tab:hover { background-color: rgba(71,83,44,.1); }
.reference-skin .upgrade-section-tab:focus { border-top-color: rgb(209,162,40); }
.reference-skin .upgrade-section { flex-grow: 1; flex-shrink: 1; min-height: 0; }
.reference-skin .upgrade-section.hidden { display: none; }
.reference-skin .section-scroll { flex-grow: 1; min-height: 0; }
.reference-skin .upgrade-grid { flex-direction: row; flex-wrap: wrap; align-content: flex-start; }
.reference-skin .upgrade-card.grid-card {
    width: 49%; height: 170px; margin: 0 1% 9px 0; padding: 0;
    flex-shrink: 0; flex-direction: row; overflow: hidden;
    background-color: transparent; border-radius: 10px;
}
.reference-skin .grid-card .upgrade-art { position: absolute; left: 12px; top: 12px; width: 100px; height: 100px; margin: 0; }
.reference-skin .grid-card .upgrade-details { position: absolute; left: 125px; top: 13px; right: 10px; bottom: 8px; padding: 0; }
.reference-skin .grid-card .upgrade-name { font-size: 24px; white-space: normal; color: rgb(26,31,20); }
.reference-skin .grid-card .upgrade-description { font-size: 18px; white-space: normal; margin: 6px 0 0 0; }
.reference-skin .grid-card .level-row { position: absolute; left: 0; bottom: 19px; height: 30px; margin: 0; }
.reference-skin .grid-card .level-dot { width: 25px; height: 30px; margin-right: 6px; }
.reference-skin .grid-card .upgrade-price { position: absolute; right: 12px; bottom: 14px; width: 130px; height: 53px; margin: 0; }
.reference-skin.section-journal .upgrade-price { background-color: rgb(59,73,30); border-color: rgb(60,71,32); border-top-color: rgb(110,126,66); border-bottom-width: 2px; border-radius: 7px; }
.reference-skin.section-journal .upgrade-price:hover { background-color: rgb(76,91,41); }
.reference-skin.section-journal .upgrade-price:disabled { opacity: .55; }
.reference-skin .grid-card .price-text { font-size: 27px; }
.reference-skin .grid-card .price-egg { width: 25px; height: 34px; }
.reference-skin .companion-layout { flex-direction: row; }
.reference-skin .companion-roster { width: 29%; margin-right: 1%; padding: 12px 8px; border-width: 1px; border-left-width: 4px; border-color: rgb(128,143,90); border-radius: 10px; }
.reference-skin .companion-roster-title { font-size: 24px; -unity-font-definition: url("ReferenceBold.ttf"); color: rgb(25,27,18); margin: 0 0 14px 5px; }
.reference-skin .companion-slot { position: relative; height: 112px; flex-shrink: 0; padding: 8px; margin: 0 0 10px 0; flex-direction: row; align-items: center; background-color: transparent; border-width: 1px; border-color: rgb(133,144,96); border-radius: 10px; }
.reference-skin .companion-slot:hover { background-color: rgba(76,86,40,.08); }
.reference-skin .companion-slot.companion-selected { background-color: rgba(180,140,68,.12); border-width: 2px; border-color: rgb(102,120,61); }
.reference-skin .companion-portrait { width: 82px; height: 84px; flex-shrink: 0; margin: 0 13px 0 0; }
.reference-skin .companion-slot-copy { flex-grow: 1; min-width: 0; }
.reference-skin .companion-slot-name { font-size: 22px; -unity-font-definition: url("ReferenceBold.ttf"); color: rgb(24,25,18); padding: 0; margin: 0; }
.reference-skin .companion-slot-status { font-size: 16px; white-space: normal; color: rgb(114,108,88); margin: 3px 0; padding: 0; }
.reference-skin .companion-purchase { height: 35px; flex-direction: row; align-items: center; justify-content: center; background-color: rgb(59,73,30); border-radius: 5px; }
.reference-skin .slot-price-egg { width: 20px; height: 27px; margin-right: 7px; }
.reference-skin .slot-price-text { font-size: 18px; color: rgb(251,244,217); margin: 0; padding: 0; }
.reference-skin .companion-details { flex-grow: 1; min-width: 0; padding: 12px 8px 0 10px; border-width: 1px; border-left-width: 4px; border-color: rgb(128,143,90); border-radius: 10px; }
.reference-skin .companion-heading { height: 99px; flex-shrink: 0; flex-direction: row; margin-bottom: 12px; align-items: center; }
.reference-skin .companion-hero { width: 110px; height: 97px; margin-right: 23px; }
.reference-skin .companion-heading-copy { flex-grow: 1; }
.reference-skin .companion-title { font-size: 34px; -unity-font-definition: url("ReferenceBold.ttf"); color: rgb(25,25,17); margin: 0; }
.reference-skin .companion-hint { font-size: 20px; color: rgb(117,108,88); white-space: normal; margin-top: 6px; }
.reference-skin .companion-details .grid-card { height: 193px; }
.reference-skin .companion-details .grid-card .upgrade-art { width: 82px; height: 86px; left: 8px; top: 10px; }
.reference-skin .companion-details .grid-card .upgrade-details { left: 101px; top: 9px; right: 6px; }
.reference-skin .companion-details .grid-card .upgrade-name { font-size: 21px; }
.reference-skin .companion-details .grid-card .upgrade-description { font-size: 16px; }
.reference-skin .upgrade-stat { font-size: 18px; color: rgb(36,37,26); margin: 8px 0 0 0; padding: 0; }
.reference-skin .companion-details .grid-card .level-row { left: -92px; bottom: 16px; }
.reference-skin .upgrade-level-count { position: absolute; right: 12px; bottom: 57px; font-size: 17px; -unity-font-definition: url("ReferenceBold.ttf"); color: rgb(36,37,26); margin: 0; padding: 0; }
.reference-skin .companion-details .grid-card .upgrade-price { width: 119px; height: 46px; bottom: 8px; right: 9px; }
.reference-skin .companion-details.no-companion .upgrade-grid { opacity: .45; }
.reference-skin .ability-grid { flex-direction: row; flex-wrap: wrap; }
.reference-skin .upgrade-card.ability-card { width: 32%; height: 478px; flex-shrink: 0; flex-direction: column; padding: 12px 12px; margin: 0 1% 8px 0; border-width: 1px; border-left-width: 4px; }
.reference-skin .ability-card .upgrade-art { width: 187px; height: 167px; align-self: center; margin: 0 0 6px 0; position: relative; }
.reference-skin .ability-card .upgrade-details { width: 100%; padding: 0; flex-grow: 0; align-items: center; }
.reference-skin .ability-card .upgrade-name { font-size: 26px; -unity-text-align: middle-center; color: rgb(23,25,17); white-space: normal; }
.reference-skin .ability-card .upgrade-description { font-size: 19px; -unity-text-align: upper-center; white-space: normal; margin-top: 4px; }
.reference-skin .ability-card .level-row { justify-content: center; }
.reference-skin .ability-card .upgrade-price { position: absolute; left: 13px; right: 13px; bottom: 14px; width: auto; height: 59px; margin: 0; }
.reference-skin .ability-card .price-text { font-size: 22px; margin-right: 7px; }
.reference-skin .ability-card .price-egg { width: 24px; height: 32px; margin-right: 5px; }
.reference-skin .ability-action { font-size: 20px; -unity-font-definition: url("ReferenceBold.ttf"); color: rgb(250,242,214); }
.reference-skin .ability-card .level-row { display: none; }
.reference-skin .ability-keys { position: absolute; bottom: 132px; left: 12px; right: 12px; height: 40px; flex-direction: row; align-items: center; justify-content: center; }
.reference-skin .keycap { height: 31px; min-width: 88px; padding: 0 12px; margin: 0; -unity-text-align: middle-center; font-size: 16px; -unity-font-definition: url("ReferenceBold.ttf"); color: rgb(38,36,24); background-color: rgb(243,234,210); border-width: 1px; border-bottom-width: 3px; border-color: rgb(70,66,48); border-radius: 6px; }
.reference-skin .key-joiner { font-size: 22px; color: rgb(38,36,24); margin: 0 10px; padding: 0; }
.reference-skin .key-hint { font-size: 18px; color: rgb(38,36,24); margin: 0 0 0 10px; padding: 0; }
.reference-skin .ability-price-row { position: absolute; left: 13px; right: 13px; bottom: 85px; height: 39px; flex-direction: row; align-items: center; justify-content: center; }
.reference-skin .ability-price-row .price-egg { width: 24px; height: 32px; margin: 0 9px 0 0; }
.reference-skin .ability-price-row .price-text { font-size: 24px; color: rgb(30,31,20); margin: 0; padding: 0; }
.reference-skin .action-egg { width: 20px; height: 27px; margin: 0 10px 0 0; }
.reference-skin .ability-status { position: absolute; left: 13px; right: 13px; bottom: 85px; height: 39px; flex-direction: row; align-items: center; justify-content: center; background-color: rgba(150,170,80,.22); border-width: 1px; border-color: rgb(150,165,95); border-radius: 5px; }
.reference-skin .check-glyph { width: 24px; height: 22px; margin-right: 9px; }
.reference-skin .ability-status-text { font-size: 21px; -unity-font-definition: url("ReferenceBold.ttf"); color: rgb(36,40,22); margin: 0; padding: 0; }
.reference-skin .ability-footer { font-size: 19px; color: rgb(116,106,83); -unity-text-align: middle-center; margin: 8px 0; }
.reference-skin .companion-purchase.unaffordable { opacity: .6; }
.reference-skin .companion-slot-copy > Label { -unity-text-align: middle-left; }
.reference-skin .ability-owned .upgrade-price:disabled { opacity: 1; background-color: rgb(146,150,116); border-color: rgb(128,132,98); }
.reference-skin .ability-owned .ability-action:disabled { opacity: 1; color: rgb(243,240,224); }
.reference-skin #future-ability .upgrade-price { font-size: 24px; -unity-font-definition: url("ReferenceBold.ttf"); color: rgb(246,242,226); }
/* Every green surface uses one olive paint with the same soft worn-paper overlay (ButtonGrain). */
.reference-skin.section-journal .upgrade-price { background-color: rgb(58,73,26); border-color: rgb(49,62,21); border-top-color: rgb(58,73,26); }
.reference-skin.section-journal .upgrade-price:hover { background-color: rgb(70,87,33); }
.reference-skin .companion-purchase { background-color: rgb(58,73,26); }
.reference-skin .side-button.side-active { background-color: rgb(58,73,26); }
.reference-skin .side-button.side-active .nav-active-art { display: none; }
.reference-skin .upgrade-section-tab.section-active { background-color: rgb(58,73,26); border-color: rgb(49,62,21); border-bottom-color: rgb(234,187,43); }
.reference-skin .upgrade-section-tab.section-active .section-olive-art { display: none; }
.reference-skin .upgrade-section-tab .button-wear, .reference-skin .side-button .button-wear { display: none; }
.reference-skin .upgrade-section-tab.section-active .button-wear, .reference-skin .side-button.side-active .button-wear { display: flex; }
.reference-skin .owned-card { background-color: rgb(58,73,26); }
